    "#Programa de ventas que permite añadir productos, tramitar pedidos, y generar informes de ventas.\n",
    "\n",
    "#Generamos listas con diccionarios para nuestros productos y los pedidos. Productos empieza con diccionarios dentro,\n",
    "#pedidos no, ya que se ira llenando con los pedidos del usuario.\n",
    "products = [\n",
    "    {\"id\": \"0\",\"nombre\": \"NvME\",\"precio\": 100,\"stock\": 50},\n",
    "    {\"id\": \"1\",\"nombre\": \"RAM\",\"precio\": 120,\"stock\": 67}\n",
    "]\n",
    "\n",
    "orders = []\n",
    "\n",
    "#Generamos una funcion independiente para cada funcionalidad del programa. Las funciones interactivas\n",
    "#se pueden detener con 'quit' para volver al menu.\n",
    "\n",
    "#Función para mostrar el catalogo\n",
    "def ft_catalog():\n",
    "    print(\"\\n\\nID  NOMBRE  PRECIO  STOCK\\n\\n\")\n",
    "    for i in products:\n",
    "        print(i[\"id\"], i[\"nombre\"], i[\"precio\"], i[\"stock\"])\n",
    "    print(\"\\n\")\n",
    "#Función para mostrar el historial de pedidos\n",
    "def ft_order_list():\n",
    "    print(\"\\n\\nPRODUCTO  CANTIDAD  PRECIO  PRECIO TOTAL\\n\\n\")\n",
    "    for i in orders:\n",
    "        print(i[\"producto\"], i[\"cantidad\"], i[\"precio_unitario\"], i[\"total\"])\n",
    "    print(\"\\n\")\n",
    "#Función para añadir productos al catalogo.        \n",
    "def ft_addproduct():\n",
    "    print(\"Escribe 'quit' para volver al menu\")\n",
    "#Comprobamos que el ID no exista en el catalogo.\n",
    "    pid = input(\"Introduce el nuevo ID: \")\n",
    "    if pid == \"quit\":\n",
    "        return\n",
    "#Se comprueba con el metodo .isdigit() que el input sea exclusivamente numerico.\n",
    "    while pid.isdigit() == False:\n",
    "        pid = input(\"El ID debe ser numerico: \")\n",
    "        if pid == \"quit\":\n",
    "            return\n",
    "#Con la funcion any() y un bucle for comprobamos que el ID introducido no coincida con ningun valor del\n",
    "#indice 'id' en nuestra lista de diccionarios.\n",
    "    while any(i['id'] == pid for i in products):\n",
    "        pid = input(\"ID no disponible: \")\n",
    "        if pid == \"quit\":\n",
    "            return\n",
    "#Registramos el nombre.        \n",
    "    pname = input(\"Introduce el nombre del producto: \")\n",
    "    if pname == \"quit\":\n",
    "            return\n",
    "#Comprobamos que el precio sea númerico y mayor que cero.    \n",
    "    pprice = input(\"Introduce el precio unitario: \")\n",
    "    while pprice.isdigit() == False or int(pprice) <= 0:\n",
    "        pprice = input(\"El precio debe ser válido: \")\n",
    "        if pprice == \"quit\":\n",
    "            return\n",
    "#Comprobamos que el stock sea númerico y mayor que cero.            \n",
    "    pstock = input(\"Introduce el stock del producto: \")\n",
    "    while pstock.isdigit() == False or int(pstock) <= 0:\n",
    "        pstock = input(\"El stock debe ser válido: \")\n",
    "        if pstock == \"quit\":\n",
    "            return\n",
    "#Guardamos los inputs en un diccionario y formateamos las variables necesarias.        \n",
    "    new_dict = {\n",
    "        \"id\": pid,\n",
    "        \"nombre\": pname,\n",
    "        \"precio\": int(pprice),\n",
    "        \"stock\": int(pstock)\n",
    "    }\n",
    "#Con el metodo .append() añadimos el nuevo diccionario a nuestro catalogo.   \n",
    "    products.append(new_dict)\n",
    "    \n",
    "    return\n",
    "#Función para realizar pedidos.\n",
    "def ft_order():\n",
    "#Mostramos el catalogo para que el usuario pueda ver el id del producto a pedir.\n",
    "    ft_catalog()\n",
    "#Creamos esta variable vacia para guardar en ella un enlace al catalogo.\n",
    "#Este enlace es muy util, ya que nos permite más adelante restar la cantidad de un producto\n",
    "#accediendo directamente a su valor en el catalogo.\n",
    "    sel_product = 0\n",
    "    \n",
    "    print(\"Escribe 'quit' para volver al menu\")\n",
    "#Comprobamos que el id exista en el catalogo.\n",
    "    pid = input(\"Introduce el ID del producto: \")\n",
    "    if pid == \"quit\":\n",
    "        return\n",
    "    while pid.isdigit() == False:\n",
    "        pid = input(\"El ID debe ser numerico: \")\n",
    "        if pid == \"quit\":\n",
    "            return\n",
    "    while not any(i['id'] == pid for i in products):\n",
    "        pid = input(\"ID no existente: \")\n",
    "        if pid == \"quit\":\n",
    "            return\n",
    "#Utilizamos el id proporcionado para encontrar el diccionario correcto en el catalogo,\n",
    "#y alamacenamos su referencia en sel_product, pudiendo asi modificar el valor de sus claves\n",
    "#\"en tiempo real\".\n",
    "    for i in products:\n",
    "        if pid == i[\"id\"]:\n",
    "            sel_product = i\n",
    "#Comprobamos que haya suficiente stock para poder tramitar el pedido.        \n",
    "    oquantity = input(\"Selecciona la cantidad deseada: \")\n",
    "    while oquantity.isdigit() == False or int(oquantity) <= 0 or int(oquantity) > sel_product[\"stock\"]:\n",
    "        oquantity = input(\"La cantidad debe ser válida: \")\n",
    "        if oquantity == \"quit\":\n",
    "            return\n",
    "\n",
    "    new_dict = {\n",
    "        \"producto\": sel_product[\"nombre\"],\n",
    "        \"cantidad\": int(oquantity),\n",
    "        \"precio_unitario\": sel_product[\"precio\"],\n",
    "        \"total\": int(oquantity) * sel_product[\"precio\"]\n",
    "    }\n",
    "#Añadimos el pedido a nuestro historial de pedidos.    \n",
    "    orders.append(new_dict)\n",
    "#Accedemos a traves del enlace a la clave stock del producto seleccionado,\n",
    "#y le restamos la cantidad pedida por el usuario.\n",
    "    sel_product['stock'] -= int(oquantity)  \n",
    "    return\n",
    "#Función para mostrar informe de ventas.\n",
    "def ft_sales():\n",
    "#Creamos variables para todo aquello que vayamos a mostrar.\n",
    "#Con la funcion sum() y un bucle for podemos agrupar todos los valores de la clave\n",
    "#que seleciconemos en nuestra lista de pedidos de manera mas sencilla.\n",
    "    product_sales = sum(i[\"cantidad\"] for i in orders)\n",
    "    sales_total = sum(i[\"total\"] for i in orders)\n",
    "#Mostramos el total de pedidos contando los elementos de nuestra lista con la funcion len().\n",
    "    total_orders = len(orders)\n",
    "#Mostramos cada una de nuestras variables.    \n",
    "    print(f\"Productos vendidos: {product_sales}\")\n",
    "    print(f\"Importe total generado: {sales_total}\")\n",
    "    print(f\"Pedidos realizados: {total_orders}\")\n",
    "\n",
    "    return\n",
    "    \n",
    "#Función principal.    \n",
    "def ft_menu():\n",
    "    ft_catalog()\n",
    "#Esta función se ejecuta indefinidamente hasta que el usuario decide salir.\n",
    "    while True:\n",
    "        print(\"(1) Catalogo | (2) Añadir producto | (3) Hacer pedido | (4) Ventas | (5) Historial pedidos\")\n",
    "        print(\"Selecciona cualquier otro caracter para salir \\n\")\n",
    "        select = input(\"¿Qué deseas hacer?: \\n\")\n",
    "        if select == \"1\":\n",
    "            print(\"##CATALOGO##\")\n",
    "            ft_catalog()\n",
    "        elif select == \"2\":\n",
    "            print(\"##AÑADIR PRODUCTO##\")\n",
    "            ft_addproduct()\n",
    "        elif select == \"3\":\n",
    "            print(\"##HACER PEDIDO##\")\n",
    "            ft_order()\n",
    "        elif select == \"4\":\n",
    "            print(\"##VENTAS##\")\n",
    "            ft_sales()\n",
    "        elif select == \"5\":\n",
    "            print(\"##PEDIDOS##\")\n",
    "            ft_order_list()\n",
