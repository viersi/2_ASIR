    "    if x > y and x > z:\n",
    "        return(x)\n",
    "    elif y > x and y > z:\n",
    "        return(y)\n",
    "    else:\n",
    "        return(z)\n",
    "\n",
    "ft_highest_3(99, 9, 300)"
