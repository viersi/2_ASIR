   "source": [
    "def ft_evens_list(x):\n",
    "    list = []\n",
    "    for i in x:\n",
    "        if i % 2 == 0:\n",
    "            list += [i]\n",
    "    return(list)\n",
    "\n",
    "ft_evens_list([58, 6, 9, 21, 87, 98])"
   ]
