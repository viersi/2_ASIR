    "def ft_nstr(x):\n",
    "    counter = 0\n",
    "    for i in x:\n",
    "        if i in \"0123456789\":\n",
    "            counter += 1\n",
    "    return(counter)\n",
    "\n",
    "ft_nstr(\"La vida es una y hay que viv1rla d4nza kudur0\")"
