   "source": [
    "def ft_is_prime(x):\n",
    "    for i in range(2, x):\n",
    "        if x % i == 0:\n",
    "            return(False)\n",
    "    return(True)\n",
    "\n",
    "ft_is_prime(5)"
   ]
