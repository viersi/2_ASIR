   "source": [
    "import math\n",
    "\n",
    "def ft_distance(x, y):\n",
    "    d = math.sqrt((y[0] - x[0])**2 + (y[1] - x[1])**2)\n",
    "    return(round(d, 2))\n",
    "              \n",
    "ft_distance([1, 1], [3, 8])"
   ]
