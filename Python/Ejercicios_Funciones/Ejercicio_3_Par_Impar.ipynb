   "source": [
    "#Determina si un numero es par o impar.\n",
    "def ft_even_odd(x):\n",
    "#Comprobación de si es divisible entre 2, en caso de si, es par.    \n",
    "    if x % 2 == 0:\n",
    "        return(\"Par\")\n",
    "    else:\n",
    "        return(\"Impar\")\n",
    "\n",
    "ft_even_odd(86)"
   ]
