   "source": [
    "def ft_fibo(x):\n",
    "    list = []\n",
    "    y = 0\n",
    "    z = 1\n",
    "    for i in range(x):\n",
    "        res = y + z\n",
    "        list += [res]\n",
    "        y = z\n",
    "        z = res\n",
    "    return(list)\n",
    "\n",
    "ft_fibo(10)"
   ]
