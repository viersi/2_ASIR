    "def ft_revstr(x):\n",
    "    list = []\n",
    "    for i in x:\n",
    "        list = [i] + list\n",
    "    return(\"\".join(list))\n",
    "\n",
    "ft_revstr(\"hola mundo!\")"
   ]
