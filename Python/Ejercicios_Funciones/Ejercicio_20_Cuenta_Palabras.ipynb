    "def ft_word_count(x):\n",
    "    j = 1\n",
    "    for i in x:\n",
    "        if i == \" \":\n",
    "            j += 1\n",
    "    return(j)\n",
    "\n",
    "ft_word_count(\"frase de prueba\")"
