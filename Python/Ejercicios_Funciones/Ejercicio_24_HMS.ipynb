   "source": [
    "def ft_time(x):\n",
    "    h = x // 3600\n",
    "    m = (x % 3600) // 60\n",
    "    s = (x % 3600) % 60\n",
    "    time = str(h) + \"h:\" + str(m) + \"m:\" + str(s) + \"s\"\n",
    "    print(time)\n",
    "\n",
    "ft_time(15875)"
   ]
