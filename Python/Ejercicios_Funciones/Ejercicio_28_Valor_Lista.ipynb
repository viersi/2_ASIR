   "source": [
    "def ft_lvalue(x, y):\n",
    "    counter = 0\n",
    "    for i in x:\n",
    "        if i == y:\n",
    "            counter += 1\n",
    "    return(counter)\n",
    "\n",
    "ft_lvalue([3, 7, 2, 3, 8, 7, 2, 9, 3, 7, 5, 2, 8, 9, 3], 7)"
   ]
