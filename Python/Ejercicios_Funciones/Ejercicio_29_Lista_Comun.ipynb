   "source": [
    "def ft_commonval(x, y):\n",
    "    list = []\n",
    "    for i in x:\n",
    "        if i in y:\n",
    "            list.append(i)\n",
    "\n",
    "    return(list)\n",
    "\n",
    "ft_commonval([3, 7, 2, 9, 5, 8, 10, 12, 14], [4, 7, 9, 10, 11, 12, 15, 18])"
   ]
