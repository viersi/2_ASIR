    "def ft_npalindrome(x):\n",
    "    x = str(x)\n",
    "    list = []\n",
    "    list_2 = []\n",
    "    for i in x:\n",
    "        list = [i] + list\n",
    "    for i in x:\n",
    "        list_2 = list_2 + [i]\n",
    "    if list == list_2:\n",
    "        return(\"Capicua\")\n",
    "    else:\n",
    "        return(\"No capicua\")\n",
    "\n",
    "ft_npalindrome(8008)"
   ]
