   "source": [
    "def ft_palindrome(x):\n",
    "    x = x.lower()\n",
    "    list = []\n",
    "    list_2 = []\n",
    "    for i in x:\n",
    "        list = [i] + list\n",
    "    for i in x:\n",
    "        list_2 = list_2 + [i]\n",
    "    if list == list_2:\n",
    "        return(\"Palindromo\")\n",
    "    else:\n",
    "        return(\"No palindromo\")\n",
    "\n",
    "ft_palindrome(\"Sos\")"
   ]
