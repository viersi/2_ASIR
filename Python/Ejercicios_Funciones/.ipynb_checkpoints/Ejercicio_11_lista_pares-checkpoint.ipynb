   "source": [
    "def ft_first_evens(x):\n",
    "    list = []\n",
    "    for i in range(1, x):\n",
    "        if i % 2 == 0:\n",
    "            list += [i]\n",
    "\n",
    "    return(list)\n",
    "\n",
    "ft_first_evens(20)"
   ]
